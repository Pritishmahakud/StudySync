# StudySync Learning Ecosystem - API Configuration
# Kashish's folder and the team code default to Anthropic Claude (or OpenAI):
# 
# Provider choices:
#   - "anthropic" (Default across team code)
#   - "openai"    (Alternative supported by CodeMentor & Shared Provider)
#   - "offline"   (Default fallback when no key is set - works 100% offline!)

STUDYSYNC_LLM_PROVIDER=anthropic

# Paste your Anthropic API Key here:
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OR if you prefer OpenAI, uncomment below:
# STUDYSYNC_LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here

# Optional model overrides:
# STUDYSYNC_MODEL=claude-3-5-sonnet-20241022
